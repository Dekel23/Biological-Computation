# Copy to backend/.env and adjust. Every variable is optional.

# SQLite file (relative to backend/)
DATABASE_URL=sqlite:///./riseup.db
# Seed the demo user with ~6 months of mock bank history on first start (1/0)
SEED_DEMO=1
# Background jobs: weekly summary, daily update, bank sync, budget alerts (1/0)
ENABLE_SCHEDULER=1
APP_TIMEZONE=Asia/Jerusalem
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
LOG_LEVEL=INFO

# WhatsApp Cloud API – leave empty to run the bot in simulation mode
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=riseup-dev-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
